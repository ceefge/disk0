{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "REPLACE_WITH_BOT_APP_ID",
  "packageName": "de.consiness.teamspoll",
  "developer": {
    "name": "consiness",
    "websiteUrl": "https://www.consiness.de",
    "privacyUrl": "https://www.consiness.de/datenschutz",
    "termsOfUseUrl": "https://www.consiness.de/nutzungsbedingungen"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Team-Umfragen",
    "full": "Team-Umfragen – einfache Abstimmungen"
  },
  "description": {
    "short": "Einfache Abstimmungen direkt in Teams – so leicht wie bei WhatsApp.",
    "full": "Erstelle in Sekunden eine Umfrage per Nachricht oder Formular. Alle stimmen mit einem Tippen ab, das Ergebnis aktualisiert sich live. Ein selbst gehosteter Ersatz für Polly."
  },
  "accentColor": "#4F6BED",
  "bots": [
    {
      "botId": "REPLACE_WITH_BOT_APP_ID",
      "scopes": [
        "team",
        "groupChat",
        "personal"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "REPLACE_WITH_YOUR_SERVER_DOMAIN"
  ]
}
